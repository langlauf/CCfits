depcomp = $(SHELL) $(top_srcdir)/config/depcomp
am__depfiles_maybe = depfiles
@AMDEP_TRUE@DEP_FILES = ./$(DEPDIR)/AsciiTable.Plo \
@AMDEP_TRUE@	./$(DEPDIR)/BinTable.Plo ./$(DEPDIR)/Column.Plo \
@AMDEP_TRUE@	./$(DEPDIR)/ColumnCreator.Plo \
@AMDEP_TRUE@	./$(DEPDIR)/ColumnData.Plo \
@AMDEP_TRUE@	./$(DEPDIR)/ColumnVectorData.Plo \
@AMDEP_TRUE@	./$(DEPDIR)/ExtHDU.Plo ./$(DEPDIR)/FITS.Plo \
@AMDEP_TRUE@	./$(DEPDIR)/FITSBase.Plo ./$(DEPDIR)/FITSUtil.Plo \
@AMDEP_TRUE@	./$(DEPDIR)/FitsError.Plo ./$(DEPDIR)/HDU.Plo \
@AMDEP_TRUE@	./$(DEPDIR)/HDUCreator.Plo ./$(DEPDIR)/KeyData.Plo \
@AMDEP_TRUE@	./$(DEPDIR)/Keyword.Plo \
@AMDEP_TRUE@	./$(DEPDIR)/KeywordCreator.Plo ./$(DEPDIR)/PHDU.Plo \
